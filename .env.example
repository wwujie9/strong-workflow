# 服务监听配置
HOST=127.0.0.1
PORT=5174
PUBLIC_BASE_URL=http://127.0.0.1:5174

# 公网 HTTPS：有证书时填相对或绝对路径，并把 PUBLIC_BASE_URL 改成 https 域名
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# 开发模式前端 API 地址；生产模式走同源 /api
VITE_API_BASE=http://127.0.0.1:5174/api

# 本地数据与文件目录
DATA_FILE=data/hazards.json
UPLOAD_DIR=server/uploads
MAX_UPLOAD_MB=15

# CORS：本地试点默认允许 Vite 开发端口；上线后改成正式域名
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 机器人 Webhook，二选一或都配置；不配置时只 dry-run
WECOM_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# 自动催办：上线后建议开启；本地演示可手动调用 /api/reminders/run
ENABLE_REMINDER_JOB=false
REMINDER_INTERVAL_MINUTES=60
